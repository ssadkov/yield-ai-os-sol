NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_PROGRAM_ID=yie1Jjq6y3rjsiGkgMYnwTveSgpSrSh4n41JHRNyBih
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_AGENT_PUBKEY=<agent pubkey from keys/agent.json>

# Global v2 IDL remains Mainnet. Mobile Devnet selects its own program explicitly.
NEXT_PUBLIC_V2_LAB_ENABLED=0
NEXT_PUBLIC_V2_PROGRAM_ID=yie1Jjq6y3rjsiGkgMYnwTveSgpSrSh4n41JHRNyBih

# Unsigned mobile API + /v2/mobile. One cluster per deployment.
V2_MOBILE_CLUSTER=devnet
V2_DEVNET_RPC_URL=https://api.devnet.solana.com
# Mainnet: private provider URL here, never in NEXT_PUBLIC_*.
V2_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# Enable only after the agreed Mainnet wallet acceptance. Plans still work with 0.
V2_MOBILE_MAINNET_SEND_ENABLED=0

# Server-only configuration (do not expose to the browser)
RPC_URL=https://api.mainnet-beta.solana.com
VAULT_PROGRAM_ID=3VtzVhc9vFWb7GaV7TtbZ1nytGzqNsASShAHjiWEFp5s
JUPITER_API_KEY=
OPENROUTER_API_KEY=

# Cron-authenticated endpoint: POST /api/cron/rebalance
CRON_SECRET=

# Authority key used to sign transactions.
# Format: JSON array (recommended): [12,34,...]  OR base58 secret key string.
AUTHORITY_SECRET_KEY=

# Optional
SLIPPAGE_BPS=100
