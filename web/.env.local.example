# Protected v2 Mainnet preview only. The browser uses a same-origin RPC proxy;
# keep SUPANODE_TOKEN server-only and enter its value in Vercel Preview env or .env.local.
NEXT_PUBLIC_V2_RPC_PROXY=0
V2_MAINNET_RPC_PROXY_ENABLED=0
V2_MAINNET_RPC_URL=https://fra.sol.supanode.xyz:8899
SUPANODE_TOKEN=
# Supanode WebSocket is not needed by the current Safe flow (HTTP status polling).

# Server-only configuration (do not expose to the browser)
